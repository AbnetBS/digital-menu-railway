# ─────────────────────────────────────────────────────────────────────────────
# Fana Cafe & Restaurant — environment variables
#
# Copy this file to `.env.local` (local development) or set these variables in
# Railway/Vercel (Project → Settings → Environment Variables) for production.
#
# ⚠️ NEVER commit a real `.env`, `.env.local`, or any file containing actual
#    secrets. This file contains PLACEHOLDERS ONLY.
# ─────────────────────────────────────────────────────────────────────────────


# ── REQUIRED (production) ────────────────────────────────────────────────────

# PostgreSQL connection string (Neon / Railway Postgres / Supabase / local).
# Without a working value the site cannot read or write any data.
# Used by: src/db/index.ts, src/db/migrate.ts
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# Owner/admin dashboard password.
# Used by: src/app/api/admin/login/route.ts (priority: env > database setting).
# ⚠️ Required in production — the code fails closed (refuses login) if neither
#    ADMIN_PASSWORD nor a DB admin_password is present.
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Secret used to sign admin/staff session cookies (HMAC-SHA256).
# ⚠️ Required in production — without it, admin and staff logins are refused.
#    Use a long random string (e.g. `openssl rand -base64 32`).
SESSION_SECRET=CHANGE_ME_RANDOM_SESSION_SECRET

# Secret used only by the Coolify scheduled task that calls receipt cleanup.
# Set this to a long random value in Coolify; never expose it to the browser.
RECEIPT_CLEANUP_SECRET=CHANGE_ME_RANDOM_CLEANUP_SECRET


# ── OPTIONAL (recommended, safe to expose to the browser) ────────────────────
# Prefix public variables with NEXT_PUBLIC_* — that is what makes them visible
# to client-side code.

# Public canonical site URL used to build sitemap.xml and robots.txt.
# If unset, the app auto-detects from the host (see "auto-provided" below).
# Used by: src/lib/site-url.ts (src/app/sitemap.ts, src/app/robots.ts)
NEXT_PUBLIC_SITE_URL=https://your-domain.example


# ── OPTIONAL (language system) ───────────────────────────────────────────────
# Base URL of the translation engine used by /api/translate for the Amharic
# auto-translation of owner-added menu items/categories/announcements.
# Leave UNSET in production — the default (https://translate.googleapis.com)
# works on any normal VPS/host (Railway, Coolify, etc.). Only set this if your
# server's network blocks Google and you route requests through a proxy.
# TRANSLATE_API_BASE=https://translate.googleapis.com


# ── AUTO-PROVIDED BY THE HOST (do not set manually) ──────────────────────────
# These are injected automatically by the deployment platform. Listed only for
# reference — the application reads them but you should not configure them:
#   RAILWAY_PUBLIC_DOMAIN  — set by Railway; sitemap/robots fallback.
#   VERCEL_URL             — set by Vercel; sitemap/robots fallback.
#   NODE_ENV               — set by the platform ("production" when deployed).
